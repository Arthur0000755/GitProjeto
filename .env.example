# ================= Telegram =================
# Crie o bot com o @BotFather e cole o token aqui
TELEGRAM_BOT_TOKEN=123456:ABC-seu-token
# IDs de usuários autorizados (separados por vírgula). Descubra o seu com @userinfobot
# ou enviando /status ao bot. Deixe vazio para liberar para todos (não recomendado).
ADMIN_IDS=
# Opcional: canal/grupo que também recebe todos os alertas (o bot precisa ser admin)
# ex.: @meucanaldepromos ou -1001234567890
TELEGRAM_CHANNEL_ID=

# ================= Geral =================
CHECK_INTERVAL_MINUTES=30
MIN_DISCOUNT=20
MAX_RESULTS_PER_SOURCE=20
DB_PATH=data/promobot.db
LOG_LEVEL=INFO

# ================= Mercado Livre =================
# Funciona sem credenciais se a API pública permitir; caso receba 401/403,
# crie um app em https://developers.mercadolivre.com.br e preencha abaixo.
MERCADOLIVRE_ENABLED=true
MERCADOLIVRE_SITE=MLB
MERCADOLIVRE_CLIENT_ID=
MERCADOLIVRE_CLIENT_SECRET=
MERCADOLIVRE_ACCESS_TOKEN=

# ================= Shopee (afiliados) =================
# https://affiliate.shopee.com.br -> Open API
SHOPEE_APP_ID=
SHOPEE_SECRET=

# ================= Amazon (PA-API 5.0) =================
# https://associados.amazon.com.br -> Ferramentas -> Product Advertising API
AMAZON_ACCESS_KEY=
AMAZON_SECRET_KEY=
AMAZON_PARTNER_TAG=seutag-20
AMAZON_HOST=webservices.amazon.com.br
AMAZON_REGION=us-east-1
AMAZON_MARKETPLACE=www.amazon.com.br

# ================= AliExpress (afiliados) =================
# https://openservice.aliexpress.com
ALIEXPRESS_APP_KEY=
ALIEXPRESS_APP_SECRET=
ALIEXPRESS_TRACKING_ID=

# ================= Feeds RSS (outras lojas / agregadores) =================
# URLs separadas por vírgula. Itens com "R$" no título/descrição viram ofertas.
RSS_FEEDS=
